# The image (relay/Dockerfile) holds the app and the relay only. The app needs none of these:
# the git history, the build tools and their screenshots, and the authors' data the tools read.
.git
node_modules
tools
ikerdata
docs
relay/.lan
relay/logs
# a working copy's own: agents' worktrees, and anything with a secret in it (a relay's log token belongs in Coolify's
# environment, never in a file here); inputs that must never be committed, should one lie about (.gitignore)
.claude
.env
.env.*
*.pem
*.graphml
*.h5ad
*.pkl
*.pickle
*.xlsx
Network_VR*
*.nii
*.nii.gz
*.dcm
*.nrrd
